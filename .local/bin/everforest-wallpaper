#!/usr/bin/env bash
set -euo pipefail

default_wallpaper="${HOME}/.config/everforest/wallpapers/fish.png"
wallpaper="${1:-$default_wallpaper}"

if [[ ! -f "$wallpaper" ]]; then
    printf 'Wallpaper not found: %s\n' "$wallpaper" >&2
    exit 1
fi

if ! command -v swww >/dev/null 2>&1; then
    printf 'swww is not installed. Run everforest-apply-system first.\n' >&2
    exit 127
fi

if ! swww query >/dev/null 2>&1; then
    swww-daemon >/dev/null 2>&1 &
    for _ in {1..20}; do
        swww query >/dev/null 2>&1 && break
        sleep 0.1
    done
fi

exec swww img "$wallpaper" \
    --resize crop \
    --transition-type simple \
    --transition-duration 1 \
    --transition-fps 30
