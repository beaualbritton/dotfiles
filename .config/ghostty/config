# Everforest Dark Hard terminal surface.
adjust-cell-height = 2%
background-blur-radius = 24
background-opacity = 0.88
bold-is-bright = false
confirm-close-surface = false
cursor-style = bar
cursor-style-blink = true
font-family = CaskaydiaMono Nerd Font Mono
font-size = 17
gtk-single-instance = true
mouse-hide-while-typing = true
quick-terminal-position = center
shell-integration = detect
shell-integration-features = cursor,sudo
term = xterm-256color
title = Ghostty
unfocused-split-opacity = 0.82
wait-after-command = false
window-height = 32
window-padding-balance = false
window-padding-x = 4
window-padding-y = 2
window-save-state = always
window-theme = dark
window-width = 110

# Native Ghostty palette; values are documented in ~/.config/everforest/README.md.
config-file = ~/.config/ghostty/theme.conf
