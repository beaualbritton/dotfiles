{
    "layer": "top",
    "position": "top",
    "height": 42,
    "margin-top": 8,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 6,

    "modules-left": [
        "hyprland/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "cpu",
        "memory",
        "network",
        "battery",
        "pulseaudio",
        "backlight"
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{icon}",
        "format-icons": {
            "active": "",
            "default": "",
            "urgent": ""
        }
    },

    "clock": {
        "interval": 1,
        "format": "  {:%I:%M %p}",
        "format-alt": "  {:%A, %B %d, %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "on-scroll": 1
        }
    },

    "cpu": {
        "interval": 3,
        "format": "  {usage}%",
        "tooltip": true
    },

    "memory": {
        "interval": 5,
        "format": "  {percentage}%",
        "tooltip-format": "{used:0.1f} GiB used of {total:0.1f} GiB"
    },

    "network": {
        "interval": 5,
        "format-wifi": "  {signalStrength}%",
        "format-ethernet": "󰈀  connected",
        "format-linked": "󰈀  linked",
        "format-disconnected": "󰖪  offline",
        "tooltip-format-wifi": "{essid}\n{ipaddr}/{cidr}\n{bandwidthDownBytes} ↓  {bandwidthUpBytes} ↑",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Network disconnected"
    },

    "battery": {
        "interval": 30,
        "states": {
            "warning": 25,
            "critical": 12
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-plugged": "  {capacity}%",
        "format-full": "󰁹  full",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁽",
            "󰁿",
            "󰂁"
        ],
        "tooltip-format": "{timeTo} · {power:.1f} W"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟  muted",
        "format-icons": {
            "headphone": "",
            "default": [
                "",
                "",
                ""
            ]
        },
        "scroll-step": 5,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip-format": "{desc}"
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "{icon}  {percent}%",
        "format-icons": [
            "󰃞",
            "󰃟",
            "󰃠"
        ],
        "scroll-step": 5
    }
}
